#!/usr/bin/env zsh
# Print a read-only, project-side status panel. Designed for macOS zsh.

set -o errexit
set -o nounset
set -o pipefail

directory="${1:-$PWD}"
directory="${directory:A}"
folder="${directory:t}"

if ! git -C "$directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  print -r -- "▛▜  ▐ CODEX ON-DEMAND ▌ ▐ DIR ${folder} ▌ ▐ NO GIT REPOSITORY ▌"
  exit 0
fi

repository="$(git -C "$directory" rev-parse --show-toplevel)"
folder="${repository:t}"
branch="$(git -C "$repository" branch --show-current)"
if [[ -z "$branch" ]]; then
  branch="@$(git -C "$repository" rev-parse --short HEAD)"
fi

git_state="$(git -C "$repository" status --porcelain=v1 --branch)"
changed="$(print -r -- "$git_state" | sed -n '3,$p' | sed '/^$/d' | wc -l | tr -d ' ')"
ahead="$(print -r -- "$git_state" | sed -n 's/.*ahead \([0-9][0-9]*\).*/\1/p')"
behind="$(print -r -- "$git_state" | sed -n 's/.*behind \([0-9][0-9]*\).*/\1/p')"

[[ -n "$ahead" ]] || ahead=0
[[ -n "$behind" ]] || behind=0

added=0
removed=0
while IFS=$'\t' read -r plus minus _; do
  [[ "$plus" == <-> ]] && (( added += plus ))
  [[ "$minus" == <-> ]] && (( removed += minus ))
done < <(git -C "$repository" diff --numstat)

stash="$(git -C "$repository" stash list | wc -l | tr -d ' ')"
last="$(git -C "$repository" log -1 --format='%h %s (%cr)')"

line="▛▜  ▐ CODEX ON-DEMAND ▌ ▐ DIR ${folder} ▌ ▐ GIT ${branch}"
(( changed > 0 )) && line+=" *${changed}"
(( ahead > 0 )) && line+=" ^${ahead}"
(( behind > 0 )) && line+=" v${behind}"
line+=" ▌"
(( added > 0 || removed > 0 )) && line+=" ▐ DIFF +${added} -${removed} ▌"
(( stash > 0 )) && line+=" ▐ STASH ${stash} ▌"

print -r -- "$line"
print -r -- "▟▙  ▐ LAST ${last} ▌"
